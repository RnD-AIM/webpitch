# Anthropic — Claude Sonnet for analysis, design, proposal
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI — gpt-image-1 for hero images, gpt-4o-mini for content enrichment
OPENAI_API_KEY=sk-proj-...

# Google AI — Gemini 1.5 Flash for color palettes (fallback hero via Imagen 3)
GEMINI_API_KEY=AIzaSy...

# Webhook auth — secret sent in X-Webhook-Secret header on incoming requests
WEBHOOK_SECRET=your-secret-here

# Default email if Telegram user has no associated email
DEFAULT_EMAIL=you@yourdomain.com

# Base URL of this server — used to build links in emails and proposals
BASE_URL=http://YOUR_SERVER_IP:3001

# n8n cloud webhook — receives job completion payload and sends email via SMTP
N8N_EMAIL_WEBHOOK=https://your-n8n-instance.app.n8n.cloud/webhook/webpitch-job-complete

# Supabase — job logging (webpitch_jobs table)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
